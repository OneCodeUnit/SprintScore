# Имя уже существующей docker-сети, в которой работает контейнер Caddy.
# Посмотреть: docker inspect -f '{{json .NetworkSettings.Networks}}' <имя-контейнера-caddy>
CADDY_NETWORK=caddy

# Образ приложения. Для отката поставьте конкретный тег вместо latest,
# например ghcr.io/onecodeunit/sprintscore:sha-1a2b3c4
SPRINTSCORE_IMAGE=ghcr.io/onecodeunit/sprintscore:latest
