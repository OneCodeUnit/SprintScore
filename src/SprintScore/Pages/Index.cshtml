@page
@model IndexModel
@{
    ViewData["Title"] = "Оценка спринта";
    ViewData["Role"] = "participant";
}

<header class="head">
    <h1 class="head__title">
        Оцените удовлетворённость прошедшим спринтом<span class="head__pick" id="pick"></span>
    </h1>
    <aside class="counters">
        <div class="counters__line">Онлайн: <b id="online">—</b></div>
        <div class="counters__line">Проголосовали <b id="voted">—</b> из <b id="total">—</b></div>
    </aside>
</header>

<partial name="_Scale" />

<div class="actions">
    <button type="button" id="confirm" class="btn btn--primary" disabled>Подтвердить</button>
    <button type="button" id="retract" class="btn btn--ghost" hidden>Голосовать заново</button>
    <p class="hint" id="hint">Выберите оценку от 1 до 10.</p>
</div>
