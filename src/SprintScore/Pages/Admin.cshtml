@page "/admin"
@model AdminModel
@{
    ViewData["Title"] = "Ведущий";
    ViewData["Role"] = "admin";
}

<header class="head">
    <h1 class="head__title">Ведущий<span class="head__pick" id="pick"></span></h1>
    <aside class="counters">
        <div class="counters__line">Онлайн: <b id="online">—</b></div>
        <div class="counters__line">Проголосовали <b id="voted">—</b> из <b id="total">—</b></div>
    </aside>
</header>

<partial name="_Scale" />

<div class="actions actions--admin">
    <button type="button" id="reveal" class="btn btn--primary">Завершить голосование</button>
    <button type="button" id="restart" class="btn btn--restart">Заново</button>
    <div class="admin-vote">
        <label for="admin-vote">Оценка ведущего</label>
        <input id="admin-vote" type="password" inputmode="numeric" autocomplete="off" aria-describedby="admin-vote-status" />
        <button type="button" id="admin-vote-clear" class="admin-vote__clear" aria-label="Очистить оценку ведущего">×</button>
        <span id="admin-vote-status" class="admin-vote__status" aria-live="polite"></span>
    </div>
    <p class="hint" id="hint">Голосование идёт. Вы можете ввести свою оценку.</p>
</div>
